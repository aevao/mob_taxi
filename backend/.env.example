# =============================================================================
# WHYP Taxi API — переменные окружения
# =============================================================================
#   cp .env.example .env   →   go run ./cmd/api
# .env не коммитится.

PORT=8080

# Где хранятся аккаунты, коды и сессии (JSON-файл, позже заменим на Postgres)
DATA_FILE=data/store.json

# -----------------------------------------------------------------------------
# Gmail SMTP — самый простой способ: свой домен не нужен, письма идут кому угодно
# (лимит Gmail ~500 писем в день). Если заданы SMTP_USER и SMTP_PASSWORD,
# используется Gmail, а Resend игнорируется.
# -----------------------------------------------------------------------------
# 1. Включи двухэтапную проверку: https://myaccount.google.com/security
# 2. Создай пароль приложения: https://myaccount.google.com/apppasswords
#    (16 символов, пробелы можно оставить)
# 3. Обычный пароль от Gmail сюда НЕ подходит.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# -----------------------------------------------------------------------------
# Resend — альтернатива для продакшена со своим доменом (https://resend.com, бесплатно 3000/мес, 100/день)
# -----------------------------------------------------------------------------
# Без ключа письма не отправляются — код печатается в консоль сервера.
#
# 1. Зарегистрируйся на resend.com → API Keys → Create API Key (Sending access)
# 2. Пока домен не подтверждён, отправитель onboarding@resend.dev может слать
#    письма ТОЛЬКО на email, с которого зарегистрирован аккаунт Resend.
# 3. Для любых получателей: Domains → Add domain (например whyp.com) →
#    добавь DNS-записи → MAIL_FROM="WHYP Taxi <no-reply@whyp.com>"
RESEND_API_KEY=

# Отправитель. По умолчанию: "WHYP Taxi <SMTP_USER>" для Gmail
# или "WHYP Taxi <onboarding@resend.dev>" для Resend.
# MAIL_FROM=WHYP Taxi <no-reply@whyp.com>

# Печатать коды в консоль даже когда Resend настроен (только для разработки)
LOG_CODES=false

# -----------------------------------------------------------------------------
# Веб-админка (web-admin). Без этих значений вход в админку отключён.
# -----------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Куда сохраняются фото из заявок водителей
UPLOADS_DIR=data/uploads
