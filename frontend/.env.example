# =============================================================================
# WHYP Taxi — переменные окружения
# =============================================================================
#
# Как использовать:
#   1. Скопируй файл:     cp .env.example .env
#   2. Вставь ключи из Google Cloud Console (см. docs/GOOGLE_MAPS.md)
#   3. Перезапусти Expo:  npx expo start -c
#
# .env не коммитится в git. Ключи начинаются с EXPO_PUBLIC_ — Expo
# подставляет их в JS-код при сборке (process.env.EXPO_PUBLIC_...).
#
# Bundle / package (для ограничений ключей в GCP):
#   iOS:     com.whypinc.passenger
#   Android: com.whypinc.passenger
#
# =============================================================================


# -----------------------------------------------------------------------------
# Google Maps — REST (Places, Geocoding, Directions)  ← ВАЖНО, ОТДЕЛЬНЫЙ КЛЮЧ
# -----------------------------------------------------------------------------
# Поиск адресов и маршруты идут через HTTP fetch с телефона.
# Ключ с restriction "iOS apps" / "Android apps" НЕ РАБОТАЕТ → REQUEST_DENIED.
#
# В Google Cloud создай НОВЫЙ ключ:
#   Application restrictions → None  (для dev; в prod — через backend)
#   API restrictions         → Places API, Geocoding API, Directions API
#
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy...rest_key_no_app_restriction
# Альтернативное имя (то же самое, если задано — имеет приоритет):
# EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=AIzaSy...rest_key


# -----------------------------------------------------------------------------
# Google Maps — iOS (нативная карта)
# -----------------------------------------------------------------------------
# ОТДЕЛЬНЫЙ ключ с restriction "iOS apps" (не подставляй сюда REST-ключ и наоборот):
#   Bundle ID → com.whypinc.passenger
#
# Важно: для react-native-maps ключ подставляется в native-конфиг через app.config.js
# (читает EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY из .env при prebuild).
#
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=AIzaSy...ios_key_here


# -----------------------------------------------------------------------------
# Google Maps — Android (нативная карта)
# -----------------------------------------------------------------------------
# Отдельный ключ с restriction "Android apps":
#   Package name → com.whypinc.passenger
#   SHA-1        → из debug keystore (см. keytool после expo run:android)
#
# Продублируется в native Android через app.config.js (не app.json).
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=AIzaSy...android_key_here


# -----------------------------------------------------------------------------
# Backend API (Go, backend/) — авторизация по email
# -----------------------------------------------------------------------------
# По умолчанию не нужен: приложение берёт IP компьютера из Metro
# (тот же, что в "Metro waiting on exp://192.168.x.x:8081") и ходит на порт 8080.
# Задай вручную, если бэкенд на другом хосте:
#
# EXPO_PUBLIC_API_URL=http://192.168.1.103:8080
#
# Directions / тарифы лучше держать на сервере — отдельный SERVER key в backend/.env:
#   GOOGLE_MAPS_SERVER_KEY=AIzaSy...server_key_here
# (не EXPO_PUBLIC_ — этот ключ не должен попадать в мобильное приложение)
